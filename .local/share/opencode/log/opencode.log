timestamp=2026-09-19T11:48:44.683Z level=INFO run=c7194927 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport ast\nsrc = open('/tmp/ta_data2/gen.py').read()\ntree = ast.parse(src)\nR = None\nfor node in ast.walk(tree):\n    if isinstance(node, ast.Assign):\n        for t in node.targets:\n            if isinstance(t, ast.Name) and t.id == 'R':\n                R = ast.literal_eval(node.value)\n        if R: break\n# merge += assignments too\nimport collections\ntrue_recs = [r for r in R if r[4] is True]\nprint(len(R), \"true:\", len(true_recs))\nfor r in true_recs:\n    print(r[0], r[1], r[2], r[3].split(\"\\n\")[0][:50])\nEOF" action.permission=* action.action=allow action.pattern=*
