timestamp=2026-09-19T10:37:18.662Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/maps14.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, json, re\n\nout = \"/media/rizky/data/projects/skripsi-sentimen/ulasan_maps_unisnu.json\"\nseen = {}\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\", \"--disable-blink-features=AutomationControlled\"])\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 950},\n        user_agent=\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\")\n    pg = ctx.new_page()\n    pgs = \"https://www.google.com/maps/search/UNISNU+Jepara\"\n    pg.goto(pgs, timeout=60000); time.sleep(11)\n    pg.locator(\"button\", has_text=re.compile(r\"^\\s*Ulasan\\s*$\")).first.click(timeout=8000)\n    time.sleep(5)\n    try:\n        pg.locator(\"span\", has_text=\"Ulasan lainnya\").first.click(timeout=8000)\n        print(\"btn lain OK\")\n    except Exception:\n        pass\n    time.sleep(6)\n\n    # deteksi elemen scroll panel modal (cari yang punya scrollHeight besar)\n    scrolls = pg.locator(\"div[class*='m6QErb']\")\n    container = None\n    for i in range(scrolls.count()):\n        try:\n            sh = scrolls.nth(i).evaluate(\"el => el.scrollHeight\")\n            if sh > 1500:\n                container = scrolls.nth(i); print(\"container idx\", i, \"h=\", sh); break\n        except Exception: pass\n    if not container:\n        container = pg.locator(\"body\")\n        print(\"fallback body scroll\")\n\n    for i in range(160):\n        try:\n            if container == pg.locator(\"body\"):\n                pg.mouse.wheel(0, 4000)\n            else:\n                container.evaluate(\"el => el.scrollBy(0, 6000)\")\n        except Exception: pass\n        time.sleep(0.6)\n        # ambil teks artikel review\n        arts = pg.locator(\"div[role='article']\")\n        n = arts.count()\n        for j in range(n):\n            try:\n                t = arts.nth(j).inner_text()\n                if t and t not in seen:\n                    seen[t] = True\n            except Exception: pass\n        if i % 20 == 0:\n            print(f\"i={i} reviews={len(seen)}\")\n    print(\"FINAL:\", len(seen))\njson.dump(list(seen.keys()), open(out, \"w\"), ensure_ascii=False, indent=1)\nb.close()\nEOF" action.permission=* action.action=allow action.pattern=*
