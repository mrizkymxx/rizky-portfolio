timestamp=2026-09-19T11:03:36.886Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/parse_ta.py <<'EOF'\nimport re, json\n\nfiles = {\n    \"attraction_jepara\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b95202400016iO07Eoiuy0AVw\",\n    \"attraction_karimun\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b9527e11001AAF2fxTJFD1FaI\",\n    \"hotel_karimun\":      \"/home/rizky/.local/share/opencode/tool-output/tool_0b9528501001W1ncK5fYiom5ow\",\n    \"hotel_jepara\":       \"/home/rizky/.local/share/opencode/tool-output/tool_0b952871b001kh7htsbeSAVZFQ\",\n}\nREGION = {\"attraction_jepara\": \"Jepara\", \"attraction_karimun\": \"Karimunjawa\",\n          \"hotel_karimun\": \"Karimunjawa\", \"hotel_jepara\": \"Jepara\"}\n\nurl_re = re.compile(r'(/[A-Za-z]+_Review-g\\d+-d\\d+-(?:Reviews-)?[A-Za-z0-9_-]+\\.html)')\n\ndef slug_name(url):\n    s = url.split(\"Reviews-\")[-1].rsplit(\".html\",1)[0]\n    for suf in (\"-Jepara_Central_Java_Java\", \"-Karimun_Jawa_Central_Java_Java\"):\n        if s.endswith(suf): s = s[:-len(suf)]\n    return s.replace(\"_\", \" \")\n\nplaces = {}\nfor cat, path in files.items():\n    txt = open(path).read()\n    seen = set()\n    for m in url_re.finditer(txt):\n        url = m.group(1)\n        base = url.replace(\"/Attraction_\", \"/A_\").replace(\"/Hotel_\", \"/H_\")\n        base = url.rsplit(\".html\",1)[0].split(\"-Reviews-\")[0]\n        # dedupe per unique canonical URL (drop OrXX pagination)\n        canon = re.sub(r'-Or\\d+', '', url)\n        if canon in seen: continue\n        seen.add(canon)\n        # nearest (N) after this occurrence\n        tail = txt[m.end():m.end()+2000]\n        c = re.search(r'\\((\\d[\\d.,]*)\\)', tail)\n        r = re.search(r'([\\d,]+) dari 5 lingkaran', tail)\n        name = slug_name(canon)\n        places[canon] = {\n            \"category\": cat.split('_')[0], \"region\": REGION[cat],\n            \"name\": name, \"url\": canon,\n            \"count\": int(c.group(1).replace('.','').replace(',','')) if c else 0,\n            \"rating\": float(r.group(1).replace(',','.')) if r else None,\n        }\n\nitems = [p for p in places.values() if p[\"region\"] in (\"Jepara\",\"Karimunjawa\")]\nitems.sort(key=lambda x: -x[\"count\"])\nprint(f\"total: {len(items)}\")\nfor p in items:\n    print(f\"{p['category']:10} {p['region']:12} {p['count']:>5} {p['rating']}  {p['name']}\")\njson.dump(items, open('/tmp/ta_places.json','w'), ensure_ascii=False, indent=1)\nEOF" action.permission=* action.action=allow action.pattern=*
