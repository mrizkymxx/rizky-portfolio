timestamp=2026-09-19T10:56:51.725Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_collect.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, re, json\n\n# halaman-halaman direktori Tripadvisor Jepara & Karimunjawa\ndirs = [\n    \"https://www.tripadvisor.co.id/Attractions-g1189712-Activities-Jepara_Central_Java_Java.html\",\n    \"https://www.tripadvisor.co.id/Attractions-g1574417-Activities-Karimun_Jawa_Central_Java_Java.html\",\n    \"https://www.tripadvisor.co.id/Restaurants-g1189712-Jepara_Central_Java_Java.html\",\n    \"https://www.tripadvisor.co.id/Restaurants-g1574417-Karimun_Jawa_Central_Java_Java.html\",\n]\nall_urls = {}\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\", \"--disable-blink-features=AutomationControlled\"])\n    ctx = b.new_context(viewport={\"width\": 1366, \"height\": 950},\n        user_agent=\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\",\n        locale=\"id-ID\")\n    pg = ctx.new_page()\n    for d in dirs:\n        try:\n            pg.goto(d, timeout=60000)\n            time.sleep(6)\n            html = pg.content()\n            # ambil semua link review tempat\n            for m in set(re.findall(r'href=\"([^\"]*(?:Attraction_Review|Restaurant_Review|Hotel_Review)[^\"]*)\"', html)):\n                u = m.replace(\"&amp;\",\"&\")\n                if \"Reviews-\" in u:\n                    all_urls[u] = True\n            # cek pagination listing berikutnya\n            print(\"DIR:\", d.split(\"/\")[-1][:50], \"| tempat:\", len(all_urls), \"| html:\", len(html))\n        except Exception as e:\n            print(\"ERR\", d.split(\"/\")[-1][:40], str(e)[:60])\n    b.close()\n\nurls = sorted(all_urls.keys())\nprint(\"TOTAL tempat:\", len(urls))\nopen(\"/tmp/ta_places.json\",\"w\").write(json.dumps(urls, indent=1))\nfor u in urls[:20]: print(u[:120])\nEOF" action.permission=* action.action=allow action.pattern=*
