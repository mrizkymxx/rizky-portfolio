timestamp=2026-09-19T11:46:26.612Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/gen_b0.py <<'PYEOF'\nimport json\n\nP = \"Yam Yam Restaurant Jepara\"\n\np1 = [\n (\"FarAway573629216\",\"Agu 2026\",\"Makanan enak enak sekali wajib coba Thai Western Foods nya dijamin bakal ketagihan.\"),\n (\"Compass1059079846\",\"Jun 2025\",\"Enak buat nyantai sama makan malam atau sore pelayananya juga baik ramah lingkungan bersih nyaman sejuk  dan murah murah\"),\n (\"Road4214859967\",\"Jul 2025\",\"Tempat ini cocok untuk makan malam tempatnya luas dan nyaman pelayanan cepat dan ramah sangat rekomen jika  berkunjung ke jepara\"),\n (\"Guide5685854145\",\"Jul 2025\",\"Ketika saya sedang bosan saya ingin mencari suatu tempat makan di area jepara dan tidak sengaja saya menemukan restoran yam yam\\nIni restoran terbaik yang pernah saya kunjungi dari beberapa tempat yang lainnya dan saya sangat puas dengan kebersihan dan juga pelayanannya yang tiada tanding\"),\n (\"ADIL\",\"Jul 2025\",\"Ini restoran terbaik yang pernah saya kunjungi dari beberapa tempat yang lainnya dan saya sangat puas dengan kebersihan dan juga pelayanannya yang tiada tanding\"),\n (\"Voyager2790608498\",\"Mei 2025\",\"Makanannya enakkkk nyaman banget tempat nya  juga bersih dan luas  ada juga tempat meeting room nya, restoran terbaik deh di Jepara\"),\n (\"garnisds\",\"Des 2024\",\"restaurant yang nyaman, tempat enak buat singgah dan makan, makanannya enak enak dan tempatnya yang bagus, staffnya ramah\"),\n (\"Aditya S\",\"Sep 2024\",\"Makanannya sangat enak sekali, dan pelayanannya sangat ramah dan gesit, cowok helpernya cantik\\u00b2 dan ganteng\\u00b2, minumanya juga enak\\u00b2 dan seger\\u00b2\"),\n (\"Abim\",\"Jul 2024\",\"Makanan enak, saya suka dengan sup tom yum nya, harga tidak terlalu mahal, tempat nyaman dengan pelayanan dan staf yang \\U0001f44d\"),\n (\"Road4869206251\",\"Agu 2024\",\"Yam Yam Resto makanannya enak banget, makanan thailand paling enak di jepara nih. saya order tom yam seafood dan pad thai seafood enak banget. waitress juga ramah banget.\"),\n (\"Wanderer5630636052\",\"Sep 2023\",\"tempatnya bagus aestetik dan nyaman cocok untuk makan bareng keluarga dan temen, makanannya juga enak enak sangat rekomended untuk dicoba, tempatnya juga sangat rrkomendet untuk didatangii\"),\n (\"Emyouconcept\",\"Jun 2024\",\"Restaurant westerent food asia food tahiland food sangat di rekomendasikan enak dan bersih nyaman pelayanan ramah menyenangkan\"),\n (\"Aditya\",\"Jun 2024\",\"Makanan enak, pelayanan bagus soale staffnya juga ramah, tempatnya enak juga buat ngobrol ngobrol bareng, ada banyak menu desert juga yang pastinya enak...\"),\n (\"apriliavara\",\"Mei 2024\",\"maknannyaaa enakk bgttt murah meriahh porsinya besarr dan tempat nya juga cozy dan instgramableeee , next kesini lg bareng temen2\"),\n (\"Wanderer5281505234\",\"Jun 2024\",\"Nggak nyesel makan disini\\nArea luas \\nSangat nyaman untuk makan bersama keluarga besar\\nMakanannya enaaaaaak sekaliiiiii\"),\n]\n\np2 = [\n (\"Aluk Lucky\",\"Jun 2024\",\"Sajian makanan has thailand satu2nya di Jepara ini sangat enak sekali. Banyak menu makanan dan minuman. Tempat sangat bersih, lokasi berada  ditengah kota\"),\n (\"Rendyagus\",\"Apr 2024\",\"Makanan di sini enak,tempat nya juga nyaman dan bersih,saya sudah beberapa kali ke sini dengan keluarga dan pasangan saya\"),\n (\"Gofud\",\"Jun 2024\",\"Yam Yam Restaurant makanan dengan rasa Ciri khas asli Thailand yang sangat istimewa\\U0001f929\\U0001f60d yg paling saya suka pad thai nya terasa banget bumbu, aromanya enak banget\"),\n (\"cinzano jr\",\"Jun 2024\",\"Tempat enak masakan enak, mudah di jangkau karena lokasi tengah kota, dengan layanan yang memuaskan, cocok untuk yang mau makan bareng teman teman\"),\n (\"Global5306991836\",\"Jun 2024\",\"Makananya enak tempatnya juga bagus, bisa buat foto foto juga pokoknya emang the best ini resto tembatnya juga bersih dan stafnya ramah\"),\n (\"Linda Ramsey\",\"Mei 2024\",\"Tempat bersih, makanan banyak farian dan juga minuman fress staff ramah cocok untuk acara dengan keluarga tercinta...\"),\n (\"Rofi Cool\",\"Mei 2024\",\"Makanannya enak, rasanya luar biasa mantapp, staffnya murah senyum dan baik sekali, Tom Yam nya paling enak di Jawa tengah\"),\n (\"Putri Aan\",\"Apr 2024\",\"Datang bersama suami cuma pengen banget makan Tom Yam Seafood,apalagi kalau pedes cocok banget pas siang siang gini..\"),\n (\"Navigate5858884004\",\"Mei 2024\",\"Tempatnya keren banget sangat nyaman dan rekomendasi, pelayanan sangat ramah dan cepat pokoknya puas banget pernah datang ke sana\"),\n (\"Fiki\",\"Apr 2024\",\"Tempatnya nyaman buat kumpul bareng teman, stafnya juga ramah ramah, makanannya juga enak, gak heran makanya ramai terus, keren\"),\n (\"bu zuli\",\"Mei 2024\",\"Rekomendasi restaurant thailand yang ada di jepara, saya suka sama tom yamnya  sii the best banget, apa lagi kalo bisa di tambahin pedes wah mantep pokoknya\"),\n (\"D_az\",\"Apr 2024\",\"Selain mereka mempunyai hotel yg bagus, mereka juga punya resto yg sangat bagus, makanan super enak, banyak pilihan makanan, staffnya juga ramah sekali, Tom Yam nya benar\\u00b2 mantapp\"),\n (\"Ridho\",\"Mei 2024\",\"tempat yang sangat recommended buat berkumpul dan makan makan bersama keluarga saudara atau teman teman untuk menu yang di tawarkan enak enak dan berkualitas pelayanannya juga baik rama\"),\n (\"Travel3144422453\",\"Mei 2024\",\"Resto yang nyaman,, instagrammable banget.. makanannya enak,, pelayanannya ramah.. pokoknya rekomen sekali untuk acara apapun\\U0001f60a\\U0001f60a\"),\n (\"Tourist6467132987\",\"Sep 2023\",\"Restoran dekat pusat kota yg nyaman untuk keluarga besar berkumpul  makan malam yg menyenagkan....masakan enak sekli cocok dilidah ..pelayanan ramah dan menyenangkan\"),\n]\n\np4 = [\n (\"Coastal5433966782\",\"Feb 2024\",\"ke cafe yam yam saya merasa sangat puas karena pelayanannya ramah,makanan enak untuk harga worth it dengan rasanya oke deh\"),\n (\"Flyer2902850012\",\"Jan 2024\",\"Makanannya enak enak, pelayanan ramah dan suasana nyaman dan bersih. Saya kesana bersama keluarga, dan keluarga saya merasa sangat senang sekali, kita merasa betah berlama lama karena suasana mendukung, dan kenyamanan yg diberikan mmg sepadan dg harga yg dibayarkan.\"),\n (\"Iihza d\",\"Mar 2024\",\"senang banget ajak keluarga buat makan di Yam Yam Restaurant,makanan thailand yang terfavorit ada tom yam seafoodnya\"),\n (\"Muhammad Khoirul haji\",\"Agu 2023\",\"Waw enakk dan mantap kali... \\nIni restaurant yang terbaik banyak kali makannan yang bisa di pilih pelayanannya pun ganteng2 dan cantik cantik\"),\n (\"Freedom4880206916\",\"Mei 2024\",\"Enak sekali makananya. Tempatnya nyaman , stafnya ramah, ada ruang ber AC juga. Parkir luas. Kalau pengen yang seger seger. Cobain deh pindang sama tomyam\"),\n (\"Pioneer3273944647\",\"Mar 2024\",\"Ada banyak kue coklat, vanila sangat enak buat cuci mulut setelah makan, dan pelayanannya juga sangat ramah, oiya banyak turis juga ternyata, wkwk\"),\n (\"Fearless1184652936\",\"Mei 2024\",\"Thai & Western Restaurant yang ada di Jepara, makan enak pol, wajib kesini. jangan lupa coba Tom Yam soupnya. rekomendasi ya\"),\n (\"FarAway0108130373\",\"Apr 2024\",\"Sarapan pagi sebelum beraktivitas seharian penuh dengan senang hati karena sudah sarapan dengan teman di yam yam restoran\"),\n (\"Solikah k\",\"Apr 2024\",\"Sarapan paginya enak, pelayanannya juga bagus , cocok si kalo habis jalan\\\" dari Alon\\\" mampir ke yam yam , tempatnya strategis ada di tengah tengah kota , pokok nya suka\"),\n (\"Eko R\",\"Agu 2023\",\"New yam yam sekarang lebih lengkap ada hotel belaya di tengah kota dan melayani antar jemput dengan armada terbaru melayani sewa harian dengan driver pengalaman city tour hub 081391758899\"),\n (\"aditya ghany\",\"Mei 2023\",\"Ngajak keluarga besar makan di resto ala thailand, porsi sangat besar, dessertnya juga enak enak sekali\"),\n (\"Trail4424025956\",\"Mei 2023\",\"Makanan enak sekali, tempatnya bagus, tomyam dan pa thai  nya enak sekali, stafnya ramah dan murah senyum\"),\n (\"Bunda a\",\"Jun 2023\",\"Makanan enak enak, tom yam soup, thai salad, dan ga praw enak banget. Tempat bagis, staff friendly.\"),\n (\"Nasi H\",\"Mei 2023\",\"Makanannya enak staffnya Ramah mas bar ganteng sangat menarik pandai bergaul asyik banget pokoknya sampai ketemu lagi ya..\"),\n (\"Ridho\",\"Feb 2023\",\"Yam yam resto adalah tempat makan yang paling recommended bagi semua orang dari segi pelayanan nya memuaskan staf karyawan nya ramah ramah murah senyum menu yang di tawarkan pun enak enak\"),\n]\n\np5 = [\n (\"Widya ningrum\",\"Jul 2023\",\"Makanann enakk tempatt stategiss..ditengah kota staffnya ramah ramah,dan pelayanannya sangat baik sekali\"),\n (\"Tewaz\",\"Mei 2023\",\"makanan enak, service paling bagus, lokasi dekat kota, dekat dengan hotel, dekat dengan pelabuhan juga, sangat keren.\"),\n (\"chocochips\",\"Jun 2023\",\"Tempat baru yang lebih modern, lebih banyak varian menu yang super duper lezaaaattt, dengan berbagai pilihan dessert yang manis manisss\"),\n (\"evi\",\"Jun 2023\",\"Tempat sangat nyaman, ber ac, pelayanan sangat ramah sekali, makanan enk enak, pizza enak sangat, sangat rekomended\"),\n (\"Aan\",\"Apr 2023\",\" makanan dan minuman nya sangat bervariasi,tempat yang bersih,pelayanan yang ramah .\\nRecommend untuk keluarga,pasangan dll\"),\n (\"Ahmad Nurlatif\",\"Jun 2023\",\"Tempatnya sangat rapi, bersih dan nyaman bisa buat nyantai atau berkumpul sama keluarga. Makanan dan minumannya enak juga sesuai sama selera dan harga terjangkau.\"),\n (\"Usfa Az\",\"Mei 2023\",\"Suka deh sama dessertnya enak banget\\nTempatnya juga  bagus dan bersih,buat nongki & foto sama temen\\\"\"),\n (\"Mbut linda\",\"Jun 2023\",\"Makanan yang enak tempat yang nyaman berada di kota bisa makan dengan pacar atau kluarga ,dan klo weekend ada pizza-nya juga.\"),\n (\"Dava Abdullah\",\"Jun 2023\",\"Candle nigth diner yang pas dengan letaknya yang strategis, waiters nya ramah steaknya enak mantapp polllll \\U0001f525\\U0001f525\\U0001f525\"),\n (\"Ayu H\",\"Jun 2023\",\"Makanan enak staff ramah pelayanan nya sangat bagus cocok untuk makan bersama pasangan dan keluarga )\"),\n (\"riskautari49\",\"Jun 2023\",\"Saya ke Restaurant Yam Yam Jepara untuk dinner sama calon pacar saya disana salad nya enak, ramah lingkungan dan harga terjangkau,nanti kalau ke jepara mampir deh ke Yam Yam Restaurant sama keluaraga.\"),\n (\"AfzaAbie\",\"Jun 2023\",\"Pas siang\\u00b2 panas, langsung cus Yam Yam Resto buat nongki sama temen\\u00b2. Minuman yg paling suka ice thai tea, ice thai green tea, & Quessadilla beef bacon. Harga terjangkau, rasa remonded, g bisa bohong.\"),\n (\"Janahh\",\"Jun 2023\",\"Tempatnya strategis makanan Dan dessert yang Bervariasi Ada meeting room juga tempatnya bersih Dan nyaman\"),\n (\"085712492065\",\"Jun 2023\",\"Tempat favorit untuk makan bersama pasangan maupun keluarga dengan harga yg relatif murah dan kualitas yg sangat bagus staff yg ramah dan tempat yg sangat nyaman \\U0001f970\"),\n (\"fakhruel\",\"Jun 2023\",\"Restaurant nya bagus ,makanan nya enak orang2 nya juga ramah & nyaman ,cocok kalau buat kumpul keluarga,teman / pasangan ..ayok mampir ke Yam yam restaurant jepara\"),\n]\n\ndef rows(page, revs, dup=False):\n    return [{\"place\": P, \"page\": page, \"rating\": 5.0, \"date\": d, \"text\": t, \"translated\": False} for _, d, t in revs]\n\nout = []\nout += rows(1, p1)\nout += rows(2, p2)\nout += rows(3, p2)   # page 3 = URL duplikat page 2\nout += rows(4, p4)\nout += rows(5, p5)\nout += rows(6, p5)   # page 6 = webfetch kembalikan konten yang sama dgn page 5\n\nwith open(\"/tmp/ta_data2/b0.ndjson\", \"a\", encoding=\"utf-8\") as f:\n    for r in out:\n        f.write(json.dumps(r, ensure_ascii=False) + \"\\n\")\n\nfrom collections import Counter\nc = Counter((r[\"place\"], r[\"page\"]) for r in out)\nprint(\"written\", len(out), \"unique\", len({json.dumps(r, ensure_ascii=False) for r in out}))\nfor k in sorted(c): print(k, c[k])\nPYEOF" action.permission=* action.action=allow action.pattern=*
