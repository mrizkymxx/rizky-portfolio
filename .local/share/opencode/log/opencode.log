timestamp=2026-09-19T11:20:06.344Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/b3_jepara_marina_bar_restaurant.ndjson <<'EOF'\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2023\", \"text\": \"New yam yam sekarang lebih lengkap ada hotel dan mobil layanan antar jemput sewa harian dengan driver pengalaman hub 081391758899 melayani city tour\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Nov 2022\", \"text\": \"Yo, gue mau sharing nih pengalaman seru gue di Jepara Marina Bar & Restaurant! Restoran ini asik banget karena pemandangannya keren banget di pelabuhan Jepara.\\nMakanannya juga enak-enak banget loh. Gue cobain seafood-nya, kayak udang sama ikan, dan semuanya fresh dan bener-bener nagih buat dicoba lagi. Plus, staff di sini juga ramah dan bisa kasih rekomendasi makanan yang oke.\\nTrus, suasana di restoran ini juga chill banget, cocok buat santai sambil makan makanan enak bareng temen-temen atau keluarga.\\nJadi, kalo kalian lagi di Jepara dan cari tempat makan enak sama suasana yang cozy, Jepara Marina Bar & Restaurant jadi rekomendasi gue deh! Pasti gue bakal balik lagi nih kalo ke Jepara lagi.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Feb 2020\", \"text\": \"Kami menyukai bungalow ini untuk melarikan diri dari Semarang selama akhir pekan, tempat yang bersih, rapi, dan layanan terbaik. Makanannya luar biasa, rasanya sangat enak, mungkin yang terbaik di Jepara, semua layanan baik tergantung pada hari ketika Anda berada di. Bagi kami, hanya satu hari untuk melarikan diri dari Semarang, menikmati pantai yang tenang, berenang dan makanan yang baik, mungkin untuk mendapatkan lebih banyak anggur dan beragam alkohol (yang kita tahu dari Semarang bisa mendapatkan pasokan seperti di Bowery dan Spiegel). Sepanjang jalan adalah tempat terbaik untuk menginap dan menikmati Jepara. Terima kasih untuk semua layanan\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 1, \"date\": \"Mar 2019\", \"text\": \"Saya melakukan perjalanan bisnis ke Jepara dan itu adalah kota kecil dengan kehidupan malam yang tidak terlalu banyak. Diperiksa dengan sopir lokal di mana ekspatriat nongkrong dan jawabannya adalah Jepara Marina Bar. Staf yang ramah, pemandangan laut yang indah, pilihan makanan dan minuman yang sangat baik. Jumat itu bagus jika Anda ingin bertemu beberapa teman baru.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2019\", \"text\": \"Kunjungi hotel ini dalam perjalanan saya dari Semarang ke Karimunjawa. Hotel yang bagus dengan kolam renang dan kamar yang bagus. Restorannya enak dan mereka memiliki makanan yang sangat enak.\\nPantai tidak terlalu bersih, jadi pergilah ke kolam renang dan jalan-jalan ke sawah dan danau.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Okt 2018\", \"text\": \"Makanan enak dan bir dingin adalah yang Anda butuhkan setelah seharian bekerja mulai dari bengkel hingga bengkel! ! !\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Feb 2019\", \"text\": \"Tempat nyaman menikmati seafood. Tim dapurnya punya pengalaman bertahun-tahun di bidang kuliner Jepara. Ownernya sangat ramah dan welcome. Recommended!\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Jan 2019\", \"text\": \"Tempat yang bagus untuk berada ketika Anda berada di untuk makanan barat. Yang terbaik di Jepara, menurut saya.\\n\\nAnda juga memiliki pemandangan laut, meskipun pada akhir pekan pantai bisa ramai.\\n\\nMasih tempat saya akan merekomendasikan siapa pun untuk datang ketika Anda berada di Jepara.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jan 2019\", \"text\": \"Restoran ini memiliki menu hidangan lokal dan internasional yang luas. Hidangan laut, daging sapi, babi, vegetarian, ayam dll. Rasa yang enak dan presentasi yang bagus.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Apr 2018\", \"text\": \"great villa, great place, great view.. suka banget dgn view di villa ini, harga sewanya juga tidak terlalu mahal\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Agu 2018\", \"text\": \"Kami menghabiskan hampir di hotel ini karena kami harus menangkap kapal cepat pagi ke Karimunjava.\\nItu mengejutkan saya karena lokasi (kolam renang yang bagus), layanan seperti bar, restoran dan bus antar-jemput gratis ke pelabuhan.\\nKamar / bungalow itu sangat bersih dan menyenangkan.\\nSarapan sangat baik; makan malam juga sangat bagus.\\nStaf sangat baik.\\nSangat direkomendasikan.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Mei 2018\", \"text\": \"Makan malam terlambat setelah kedatangan terlambat dan menginap di hotel yang sama. Terkejut menemukan salmon asap di menu sebagai starter dan harus mengatakan bahwa itu cukup baik. Kursus utama adalah pizza yang ternyata dipanggang dengan baik dan dengan bagian bawah yang tipis. Sangat Italia: -). Sejak gasbottle selesai saya harus menunggu sampai seseorang membawa yang baru. Tetapi staf itu meminta saya dan meminta maaf atas ketidaknyamanan ini. Jika saya mau, saya bisa membatalkan pesanan. Saya senang saya baru saja minum jus buah dan menunggu pizza. Restoran dan layanan untuk menjadi recommanded. Ini membantu ketika Anda berbicara bahasa Inggris dasar.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mar 2018\", \"text\": \"Jepara adalah kota kecil yang indah di pantai utara Jave tengah, menghadap ke barat sehingga Anda memiliki matahari terbenam yang indah di malam hari. Jepara Marina Bungalows menawarkan pemandangan indah, dan lokasi yang sangat damai tepat di pantai, kolam renang yang bagus dan restoran yang cukup bagus. Tidak mudah menemukan makanan barat yang baik di bagian dunia ini, jadi jika Anda suka daging domba, pizza, atau steak, maka sangat disarankan. Memiliki pilihan masakan Asia yang baik juga. Terbaik di area yang telah kita lihat. Sangat merekomendasikan tinggal dan makan di sini.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Sep 2017\", \"text\": \"Hotelnya selalu full booked karena hanya beberapa kamar saja. Harganya cukup murah untuk resort depan pantai, makanannya cukup enak dan kolamnya asik.\"}\n{\"place\": \"jepara_marina_bar_restaurant\", \"page\": 1, \"rating\": 4, \"date\": \"Feb 2018\", \"text\": \"Lokasi di pinggir pantai teluk awur, dengan pemandangan yg indah, makanan yg cukup enak, harga yg sepadan, tetapi pelayanan masih kurang menurut saya, pelayannya seperti ogah\\\"an untuk menyajikan di meja, kurang puas dengan pelayanannya, pemandangan indah, tetapi kapal yg terparkir di darat mengganggu pemandangan yg seharusnya terlihat sunset tetapi terhalang kapal, untuk pool nya /orng harus membayar 100rb. Terlalu mahal untuk kolam seperti itu.\"}\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:06.345Z level=INFO run=c7194927 message=evaluated permission=bash pattern="wc -l /tmp/ta_data/b3_jepara_marina_bar_restaurant.ndjson" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:09.530Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/b3_cumibar_restaurant_lounge_bar.ndjson <<'EOF'\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Jan 2020\", \"text\": \"Kami mengunjungi cumibar dua kali selama perjalanan kami untuk makan siang dan yang untuk makan malam, saya pasti akan merekomendasikan makanan yang lezat, layanan yang fantastis dan pemandangan dan hati! Anda mungkin membayar sedikit lebih banyak daripada tempat lain di pulau itu, tetapi itu pasti sepadan.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Des 2019\", \"text\": \"Para pelayan sangat baik dan ramah dan makanannya sangat lezat. Pemandangan indah dari restoran yang menghadap ke laut.\\nDirekomendasikan!\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 3, \"date\": \"Mei 2019\", \"text\": \"Restoran ini menawarkan pemandangan yang bagus tetapi saya akan mengatakan mereka perlu melatih staf lebih banyak. Mereka tidak dapat menjelaskan apa hidangan itu dan ketika disajikan, itu hidangan berbeda dari apa yang kami pesan. Saya memesan sepiring kecil makanan penutup. Saya tidak ingat namanya tetapi kue itu kering dan buahnya tidak terasa segar.\\n\\nSaya pikir mereka dapat memperbaiki menu juga, menu yang dicetak dengan baik akan lebih baik untuk tempat usaha seperti ini.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 4, \"date\": \"Agu 2018\", \"text\": \"resto terbaik di Karimunjawa, dan ive menikmati tempat ini dengan pantai yang jernih dan biru di depan resto, tentang makanan, tidak terlalu buruk, tetapi memiliki porsi kecil, tapi oke, menyebabkan lokasi wisata dan terletak di pulau karimunjawa\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Jan 2018\", \"text\": \"salah satu restoran yang rame dan enak di karimunjawa\\nharganya tidak terlalu mahal\\npelayanannya okee\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2018\", \"text\": \"Restoran ini adalah \\\"ya\\\" baik untuk lokasi dan makanan. Layanan juga baik. Untuk direkomendasikan, terutama di pulau di mana berbagai makanan dan kualitas sering miskin. Beberapa km di luar kota karena itu Anda akan membutuhkan skuter.\\nDengan \\\"Snoopy\\\"\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 1, \"date\": \"Jul 2018\", \"text\": \"Setelah beberapa hari di Karimunjawa kami menemukan tempat ini yang terlihat cukup baik dan mewah sehingga kami memutuskan untuk mencobanya,\\n\\nKetika kami tiba semuanya tampak sempurna. Teras yang bagus dan suasana yang luar biasa. Kami memesan Bintang besar dan kejutan pertama malam kami, itu hangat!\\nKemudian kami memesan makanan, dan kami harus menunggu selama satu jam, bahkan mereka hanya 10 pelanggan lainnya.\\nKemudian mereka melayani kami cumi-cumi alih-alih prawing.\\nKemudian selada di salad memiliki bintik-bintik hitam di dalamnya dan pelayan mengatakan itu normal jadi kami menolak untuk memakannya dan mengembalikannya.\\nHidangan utama yang kami punya adalah porsi kecil hambar ikan dengan nasi.\\nDan akhirnya kami memiliki es krim coklat yang merupakan satu-satunya hal yang baik tentang makan malam kami.\\n\\nKetika kami meminta tagihan mereka tidak mengenakan biaya untuk salad karena kami tidak memakannya.\\n\\nKemudian kami meminta kepada manajer restoran untuk melihat wanita Prancis yang bertugas di atasnya. Setelah beberapa menit ragu dia memutuskan untuk memanggilnya dengan walkie talkie dan kami bisa mendengar mereka berbicara selama sekitar 5 menit. Dia kembali kepada kami dan mengatakan bahwa yang bertanggung jawab tidak tersedia dan kami bisa menjelaskan masalah apa pun kepadanya karena dia adalah manajer.\\nDia menyesal untuk semuanya, bahwa mereka memiliki malam yang sangat sibuk dan beberapa staf masih baru.\\n\\nSejujurnya kami memiliki makanan yang lebih baik di beberapa warung lokal di sekitar kota membayar sepertiga dari apa yang kami bayar, layanan cepat dan dengan profesional yang nyata.\\n\\nSekarang setelah kami kembali dari perjalanan 3 minggu kami di Indonesia, kami dapat mengatakan bahwa itu adalah pengalaman terburuk kami secara keseluruhan.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Apr 2018\", \"text\": \"Kami telah makan di restoran 2 malam berturut-turut karena makanan yang luar biasa. Bruschetta benar-benar baik diikuti oleh toneng kelas master.\\nDi atas semua itu, pemandangan itu hanya menakjubkan. Pastikan untuk pergi ke sana sebelum matahari terbenam untuk mendapatkan pemandangan di perbukitan hutan. . setelah matahari terbenam Anda akan melihat armada kapal cumi-cumi di cakrawala melakukan pekerjaan mereka. Ini saja sudah cukup untuk merekomendasikan tempat ini, namun tidak\\nHanya makanannya, juga stafnya sangat sopan dan selalu ramah.\\nJika Anda tetap di karimunjawa - pastikan untuk mengunjungi tempat ini.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Mar 2018\", \"text\": \"Kami tinggal di hotel ini sehingga kami memiliki setiap hari super sarapan dan juga kami memiliki 2 makan malam yang besar di sini. dan setiap hari beberapa ekor coctails sebelum tidur. : -)\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2017\", \"text\": \"Sebenarnya saya mengunjungi Breve Azurine Resort dan Cumi Bar yang terletak di dalam resort. Mereka memiliki lingkungan yang indah yang tidak dapat dibeli dengan uang apa pun. Jika Anda mengunjungi tempat ini, Anda harus mencoba makanan mereka juga, atau Anda akan merasa diri Anda sendiri?\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 2, \"date\": \"Sep 2017\", \"text\": \"Kami tinggal di hotel dan ditawari paket lobster, untuk memesan di muka, yang kami pikir itu ok karena kami tidak ingin pergi sekitar malam pertama. sayangnya ketika kami menemukan paket itu hanya lobster, Anda harus memesan yang lain seperti nasi, sayuran, dan air. . . jadi apa paket itu termasuk?\\nJawaban manajemen adalah sesuatu yang akan saya gunakan ketika mengajarkan betapa buruknya layanan pelanggan. Manajer hubungan memberi tahu kami bahwa kosakata mereka! ! ! ! ! Saya masih bertanya-tanya mengapa mereka tidak menggunakan kosa kata bahasa indonesia atau bahasa inggris. . .\\nJelas kami membayarnya karena kami tidak begitu pelit atau tidak berpendidikan untuk tidak membayar 100 k untuk tagihan 2, 5 mil untuk makan malam, tetapi mereka benar-benar terlihat konyol.\\nJika Anda bersama dengan anak-anak kecil menghindari tempat karena sangat berangin dan tidak ada tempat yang dilindungi.\\nJika Anda tidak tidur di hotel tidak ada alasan bagi Anda untuk mengunjungi tempat ini, cobalah \\\"makan dan temui\\\" atau pasar lokal terlebih dahulu.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2017\", \"text\": \"Mudah ditemukan di pulau ini. Pemandangan yang luar biasa. Staf yang indah. Makanan enak. Bersihkan toilet sebelah barat. Minuman dingin dan mereka menyajikan alkohol.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 4, \"date\": \"Agu 2017\", \"text\": \"menu terutama indonesia, saya mencoba banyak hidangan dan semua dilakukan dengan baik dan lezat. Layanan cepat dan ramah. pasti media dan disarankan.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2017\", \"text\": \"Makanan yang sangat baik dengan sentuhan Eropa. Jika Anda makan dengan makanan lokal, nasi dll. Benar-benar orang baik, disambungkan ke anggur dan koktail. Bagus suasana di lokasi yang baik.\"}\n{\"place\": \"cumibar_restaurant_lounge_bar\", \"page\": 1, \"rating\": 1, \"date\": \"Nov 2016\", \"text\": \"Layanan yang buruk, kami mengunjungi untuk beberapa waktu dan bahagia orang yang meminta saya untuk membayar $100. 000 untuk menikmati pantai freakin itu, dan dia mengatakan bahwa ini adalah pantai pribadi, sebagai informasi kami tentang untuk makan siang tapi kami berubah pikiran kita karena orang itu.\"}\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:09.530Z level=INFO run=c7194927 message=evaluated permission=bash pattern="wc -l /tmp/ta_data/b3_cumibar_restaurant_lounge_bar.ndjson" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:11.285Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/b3_the_happinezz_tours_karimunjawa.ndjson <<'EOF'\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Nov 2018\", \"text\": \"Saya datang ke Karimunjawa untuk kedua kalinya, dan akan datang lagi suatu hari nanti. . . karena Pulau Karimunjawa adalah tujuan wisata yang pantas menjadi daftar untuk dikunjungi, ketika Anda di pulau karimunjawan Anda disuguhi keindahan pantai dan keindahan biota laut\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 4, \"date\": \"Nov 2017\", \"text\": \"Pantai Karimun Jawa yang indah dengan gugusan pulau2 kecillayak anda kunjungi.Fasilitas Hotel/Home stay penduduk sangat terjangkau penduduknya yang komunikatif dan sangat bersahabatmembuat pengunjung ingin kembali mengunjungi Karimun Jawa.\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Sep 2018\", \"text\": \"Apa gym tersembunyi dari sebuah pulau. kami diberitahu tentang pulau ini adalah java oleh lokal dan betapa bahagianya kami diberitahu! ! Tempat ini akan sangat sibuk dalam 10 tahun mendatang yang bisa saya jamin. Kami melakukan tur snorkeling salah satu dari hari-hari dan itu bernilai setiap sen kecil yang kami bayar untuk itu. Beruntung untuk melihat lumba-lumba dan Turtles dan pulau-pulau kecil di lepas karimunjawa di mana kami memiliki bbq di luar biasa. Panduan kami Adam hari itu luar biasa. Sangat sangat merekomendasikan\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2018\", \"text\": \"Salah satu pulau indah di indonesia. Anda tidak akan menyesalinya. Saya menggunakan paket khusus dari holidaykarimunjawa [dot] com. Mereka melayani kami dengan sangat lembut dan baik, dari pemandu sampai semua perjalanan.\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2018\", \"text\": \"Awak luar biasa, tur dan makanan / minuman.Kami memesan tur snorkling melalui The Happinez. Semuanya diatur dengan sangat lancar, dan kami mengalami hari yang menyenangkan di atas air. Mengunjungi tempat snorkeling bagus dan makan siang yang luar biasa - BBQ di pulau tropis kecil. Para pemandu melakukan pekerjaan hebat dan menghormati alam dan penghuninya.Sangat disarankan untuk sarapan atau makan siang di tempat ini. Mereka menawarkan berbagai macam makanan dan minuman yang belum pernah saya lihat di tempat lain di Karimunjawa. Bagus es kopi / cappuccino dan campuran yang baik dari makan siang / sarapan barat / Indonesia untuk harga yang wajar.Para kru luar biasa dan membiarkan Anda merasa sangat diterima di tempat mereka.\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2017\", \"text\": \"Bersama dengan teman kami mengunjungi Joyce dan Sudar Happinezz di hostel ini. Kami mengunjungi banyak pantai yang indah, dan sudut pandang dibenci terapung di pulau dengan skuter. Dan membuat tur perahu kecil ke pulau termasuk snorkeling dan makan siang. Saya suka pulau ini sangat banyak seperti wisata tidak (belum). Terima kasih untuk sambutan hangat! Melihat Anda segera, Arjen\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2017\", \"text\": \"Hari ini kami menyewa skuter. Bersama dengan pemandu wisata kami melakukan perjalanan di sekitar pulau. Ini adalah indah, semua tempat yang kami lihat dengan seperti pemandangan yang bagus! Juga pemandu wisata mengatakan kepada kami begitu banyak tentang pulau, pantai de dan banyak lagi. Kami memiliki hari besar dan melihat banyak!\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Feb 2017\", \"text\": \"Jangan ragu untuk datang ke sana! Salah satu yang terbaik yang kami pernah tinggal di Asia! Terima kasih lagi Joyce dan Sudhar ini pengalaman menginap yang luar biasa! Ingin yang terbaik dan berharap untuk melihat Anda lagi :)\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Mar 2017\", \"text\": \"Aku pergi untuk snorkeling, itu begitu menakjubkan bahwa aku kembali keesokan harinya. Segala sesuatu yang sangat terorganisir, drop off di pelabuhan, dengan ikan segar yang lezat makan siang, snack di sore hari dengan buah, air segar. Dan dunia bawah air di Karimunjawa hanya meninggalkan Anda terengah-engah, karang, ikan warna-warni dan beruntung untuk melihat beberapa kura-kura. Anda juga bisa meminta mereka untuk perahu atau meminta informasi tentang pemesanan tiket penerbangan dari Karimunjawa ke Surabaya. Selalu mendapatkan pelayanan yang terbaik.\"}\n{\"place\": \"the_happinezz_tours_karimunjawa\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2016\", \"text\": \"Saya pergi ke tempat yang luar biasa ini hampir 1 tahun yang lalu. Pada saat ini saya berencana untuk kembali lagi dan melihat tempat kedua 'di happinezz' dibuka. Keramahan dan suasana luar biasa yang membuat saya ingin kembali lagi! Rumah bersih, indah dan jauh lebih daripada yang saya pikir! Joyce dan Sudar sangat bagus dan membuat waktu Anda di Karimunjawa bahkan lebih istimewa! Jika Anda belum melihat Karimunjawa Kunjungi happinezz, mereka akan memastikan pengalaman menginap Anda menjadi kenangan yang indah akan senang!\"}\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:11.285Z level=INFO run=c7194927 message=evaluated permission=bash pattern="wc -l /tmp/ta_data/b3_the_happinezz_tours_karimunjawa.ndjson" action.permission=* action.action=allow action.pattern=*
timestamp=2026-09-19T11:20:12.492Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/b3_melatee_restaurant.ndjson <<'EOF'\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2025\", \"text\": \"Pertama kali kesini bersama teman ku ke sini di layani baik banget makanan nya juga enak banget dan minuman .dah lingkunganya bersih sejuk\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2025\", \"text\": \"Tempatnya luas dan nyaman pelayanan cepat penyajian nya juga cepat banhan makanan sehat dan segar cocok juga buat kamu yang veget bannget\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2025\", \"text\": \"Saya mengunjungi melatee restoran pertama kalinya dan seketika itu saya dimanjakan dengan beberapa fasilitas yang sangat nyaman\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jul 2025\", \"text\": \"Saya menilai 1000% untuk tempat ini karena tempat yang sangat nyaman dan cocok untuk merelaksasikan diri anda, dan dari segi faslitas yam yam restoran tidak kalah saing dengan yang lainnya\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2025\", \"text\": \"Makanannya enakkkk cake nya enak sekali gak kemanisan pas rasanya bikin nagih Jagan sampai gak coba deh ,bakal nyesel kamu kalau gak coba enaknya Makana disini\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Nov 2024\", \"text\": \"Makanan yang lezat dan pelayanan yang ramah..! saya sangat puas dengan pengalaman makan disini, tempat yang nyaman dan makanan yang berkualitas, pelayanan yang cepat dan harga terjangkau suasana yang hangat\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2024\", \"text\": \"Enak sii, suka sama makananya steak nya enak suasananya juga tenang, bisa untuk santai sambil ngobrol, mau cobain lagi kalau nanti balik ke jepara lagii\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Tempat bersih, makananya enak, staff ramah, tempatnya terlihat kecil tapi sebenarnya lumayan besar, ada hotelnya juga, suka sama makananya\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2024\", \"text\": \"Melatee Restaurant Jepara makanannya enak poll. tempatnya ditengah tengah kota, restonya bersih dan nyaman buat buat dinner.\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Sep 2023\", \"text\": \"tempat ini cocok untuk makan keluarga maupun makan bareng temen temen, makanannya juga rekomended. tempatnya nyaman dan instagramble\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"ada banyak varian menu dari yang asian sampai international, dari steak cemilan sampe salad saya suka semuanya, overall semuanya good\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"Menunya menawarkan beragam pilihan, dan semua yang kami coba lezat.kagum dengan semua layanan terbaik yang diberikan pada pelanggan.\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Makana enak tempat cozy dan instgramable nyaman buat anak 2 dan banyak lampu makanan yang porsi besar makanan enak penyajian cepat\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Apr 2024\", \"text\": \"tempatnya nyaman, dan makannya posrsi besar tapi murah meriahh cocok buat family time dan gurl time…… next mau kesiinii lg\"}\n{\"place\": \"melatee_restaurant\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Restaurant yg bagus \\nDitengah kota Jepara\\nStaff yang  sangat ramah \\nTempatnya bersi hj\\nCocok untuk makan bersama teman atau keluarga\"}\nEOF" action.permission=* action.action=allow action.pattern=*
