timestamp=2026-09-19T10:49:53.120Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/bk_hotel_scrape.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, re, json\n\nslug = \"eco-casa-resort\"\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\", \"--disable-blink-features=AutomationControlled\"])\n    ctx = b.new_context(viewport={\"width\": 1366, \"height\": 950},\n        user_agent=\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\",\n        locale=\"id-ID\")\n    pg = ctx.new_page()\n    pg.goto(f\"https://www.booking.com/hotel/id/{slug}.id.html\", timeout=60000)\n    time.sleep(9)\n    print(\"title:\", pg.title()[:60])\n    # klik link/tab ulasan\n    for sel in [\"text=Ulasan\", \"a[href*='#tab-reviews']\", \"text=Lihat ulasan\", \"button:has-text('ulasan')\"]:\n        try:\n            pg.locator(sel).first.click(timeout=6000)\n            print(\"KLIK:\", sel); break\n        except Exception: pass\n    time.sleep(5)\n    # scroll halaman penuh beberapa kali\n    for i in range(40):\n        pg.mouse.wheel(0, 6000); time.sleep(0.8)\n    html = pg.content()\n    open(f\"/tmp/bk_{slug}_expanded.html\",\"w\").write(html)\n    print(\"html len after scroll:\", len(html))\n    b.close()\nEOF" action.permission=* action.action=allow action.pattern=*
