timestamp=2026-09-19T11:20:16.176Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/b3_tipp_restaurant_jepara.ndjson <<'EOF'\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Agu 2024\", \"text\": \"Makanan enak sekali, wajib dicoba bagi pecinta mie. mie kari ayam rasanya enak polll wajib dang lagi karena rasanya mantul.\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"waww tempatnya nyaman, bersih, dan harga makanannya terjangkau servicnya baik dan ramah² pokoknya seru😍 rekomendasi banget\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"tempatnya nyaman, pelayanannya juga oke\\nberbagai macam menu menarik yang membuat kita jadi penasaran dan ingin mencoba semua menu yang ada\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Tempat makan dan nongkrong nyaman dengan makanan yang enak di tengah kota jepara,pelayanan baik ramah dan menyenangla.\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Rekomendasi tempat makan enak Halal di tengah kota jepara jawa tengah indonesai. Cocok juga untuk tempat nongkrong rapat dan acara keluarga\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"untuk tempat saya suka soale nyaman, makananan juga enak, saya kira cuma mie aja ternyata ada varian nasi juga, staff ramah juga\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Restaurant yang tergolong baru makanannya enak tempatnya juga nyanan, enak buat kumpul bareng keluarga, anak anak pasti suka soale konsep e mie\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"Dari saat saya tiba sampai saya pergi, saya merasa disambut dan dimanjakan oleh makanan dan layanannya. Saya sangat merekomendasikannya\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"Makanannya enak sekali harga terjangkau tempat yang nyaman buat kumpul keluarga harganya terjangkau dan porsi makanannya sangat besar\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"maknannya enak dan tempatnya cozy , instagramable , harganya terjangkauuu nyaman bgt buat kumpul2 temen atau keluarga\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Berbagai menu mi \\nBuat pecinta mi sangat cocok\\nPorsi sangat besar\\nLokasi strategis\\nCocok untuk nongki bersama teman maupun keluarga\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Jun 2024\", \"text\": \"Jangan ragu untuk penikmat mi jangan lupa mampir di Tipp restaurant ya.. Makanan dengan porsi yang besar dan sangat lezat. Tempatnya sangat bersih dengan staff yang ramah2\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Apr 2024\", \"text\": \"Makanan nya enak dan tempat nya juga nyaman,cocok untuk ngumpul keluarga dan pasangan,sangat rekomendasi banget,,,,\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"Sangat rekomendasi untuk yang suka kulineran, tempat nyaman dengan view jalan dan Tamanan,juga dengan makanan nya yang rekomendasi,belum pernah ada mie di Jepara yang kaya gini\"}\n{\"place\": \"tipp_restaurant_jepara\", \"page\": 1, \"rating\": 5, \"date\": \"Mei 2024\", \"text\": \"Tempat yang sangat luas dan dengan view tanaman yang sangat bagus, sehingga membuat kita saat makan menjadi lebih nyaman\"}\nEOF" action.permission=* action.action=allow action.pattern=*
