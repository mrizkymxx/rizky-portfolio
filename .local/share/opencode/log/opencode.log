timestamp=2026-09-19T11:03:01.519Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/parse_ta.py <<'EOF'\nimport re, sys, glob, json\n\nfiles = {\n    \"attraction_jepara\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b95202400016iO07Eoiuy0AVw\",\n    \"attraction_karimun\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b9527e11001AAF2fxTJFD1FaI\",\n    \"hotel_karimun\":      \"/home/rizky/.local/share/opencode/tool-output/tool_0b9528501001W1ncK5fYiom5ow\",\n    \"hotel_jepara\":       \"/home/rizky/.local/share/opencode/tool-output/tool_0b952871b001kh7htsbeSAVZFQ\",\n}\n\nurl_re = re.compile(r'^(/[A-Za-z]+_Review-g\\d+-d\\d+-[^)]*?\\.html)(?:#REVIEWS)?\\)?$')\n\nplaces = {}\ndef add(p):\n    k = p[\"url\"]\n    if k in places and p.get(\"count\", 0) <= places[k].get(\"count\", -1):\n        return\n    places[k] = p\n\nfor cat, path in files.items():\n    txt = open(path).read()\n    # split into listing blocks at each image bullet\n    blocks = re.split(r'(?=-\\s+\\[!\\[)', txt)\n    for b in blocks:\n        m = re.search(r'\\[([^\\]]+)\\]\\((/[A-Za-z]+_Review-g\\d+-d\\d+-[^)]*?\\.html)\\)', b)\n        if not m: continue\n        name, url = m.group(1).strip(), m.group(2)\n        if len(name) < 2: continue\n        cr = re.search(r'dari 5 lingkaran\\s*\\n+\\s*\\(([0-9.,]+)\\)', b)\n        rr = re.search(r'(\\d,\\d) dari 5 lingkaran', b)\n        count = int(cr.group(1).replace(',', '')) if cr else 0\n        rating = float(rr.group(1).replace(',', '.')) if rr else None\n        add({\"category\": cat.split('_')[0], \"region\": cat.split('_')[-1],\n             \"name\": name, \"url\": url, \"count\": count, \"rating\": rating})\n\nitems = sorted(places.values(), key=lambda x: -x[\"count\"])\nprint(f\"total unik: {len(items)}\")\nfor p in items:\n    print(f\"{p['category']:10} {p['region']:8} {p['count']:>5} {p['rating']}  {p['name']}\")\njson.dump(items, open('/tmp/ta_places.json', 'w'), ensure_ascii=False, indent=1)\nEOF" action.permission=* action.action=allow action.pattern=*
