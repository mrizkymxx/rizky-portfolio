timestamp=2026-09-19T11:23:10.051Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/yam_yam_restaurant_jepara.ndjson <<'EOF'\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Agu 2026\",\"text\":\"Makanan enak enak sekali wajib coba Thai Western Foods nya dijamin bakal ketagihan.\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2025\",\"text\":\"Enak buat nyantai sama makan malam atau sore pelayananya juga baik ramah lingkungan bersih nyaman sejuk  dan murah murah\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2025\",\"text\":\"Tempat ini cocok untuk makan malam tempatnya luas dan nyaman pelayanan cepat dan ramah sangat rekomen jika  berkunjung ke jepara\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2025\",\"text\":\"Ketika saya sedang bosan saya ingin mencari suatu tempat makan di area jepara dan tidak sengaja saya menemukan restoran yam yam\\nIni restoran terbaik yang pernah saya kunjungi dari beberapa tempat yang lainnya dan saya sangat puas dengan kebersihan dan juga pelayanannya yang tiada tanding\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2025\",\"text\":\"Ini restoran terbaik yang pernah saya kunjungi dari beberapa tempat yang lainnya dan saya sangat puas dengan kebersihan dan juga pelayanannya yang tiada tanding\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Mei 2025\",\"text\":\"Makanannya enakkkk nyaman banget tempat nya  juga bersih dan luas  ada juga tempat meeting room nya, restoran terbaik deh di Jepara\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Des 2024\",\"text\":\"restaurant yang nyaman, tempat enak buat singgah dan makan, makanannya enak enak dan tempatnya yang bagus, staffnya ramah\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Sep 2024\",\"text\":\"Makanannya sangat enak sekali, dan pelayanannya sangat ramah dan gesit, cowok helpernya cantik² dan ganteng², minumanya juga enak² dan seger²\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2024\",\"text\":\"Makanan enak, saya suka dengan sup tom yum nya, harga tidak terlalu mahal, tempat nyaman dengan pelayanan dan staf yang 👍\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Agu 2024\",\"text\":\"Yam Yam Resto makanannya enak banget, makanan thailand paling enak di jepara nih. saya order tom yam seafood dan pad thai seafood enak banget. waitress juga ramah banget.\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Sep 2023\",\"text\":\"tempatnya bagus aestetik dan nyaman cocok untuk makan bareng keluarga dan temen, makanannya juga enak enak sangat rekomended untuk dicoba, tempatnya juga sangat rrkomendet untuk didatangii\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2024\",\"text\":\"Restaurant westerent food asia food tahiland food sangat di rekomendasikan enak dan bersih nyaman pelayanan ramah menyenangkan\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2024\",\"text\":\"Makanan enak, pelayanan bagus soale staffnya juga ramah, tempatnya enak juga buat ngobrol ngobrol bareng, ada banyak menu desert juga yang pastinya enak...\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Mei 2024\",\"text\":\"maknannyaaa enakk bgttt murah meriahh porsinya besarr dan tempat nya juga cozy dan instgramableeee , next kesini lg bareng temen2\"}\n{\"place\":\"yam_yam_restaurant_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2024\",\"text\":\"Nggak nyesel makan disini\\nArea luas \\nSangat nyaman untuk makan bersama keluarga besar\\nMakanannya enaaaaaak sekaliiiiii\"}\nEOF" action.permission=* action.action=allow action.pattern=*
