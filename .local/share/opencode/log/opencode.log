timestamp=2026-09-19T10:48:33.512Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/bk_reviews.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, re, json, urllib.parse, urllib.request\n\ndef fetch_with_playwright(page_html_out, url, sleep=8):\n    with sync_playwright() as p:\n        b = p.chromium.launch(headless=True, args=[\"--no-sandbox\", \"--disable-blink-features=AutomationControlled\"])\n        ctx = b.new_context(viewport={\"width\": 1366, \"height\": 950},\n            user_agent=\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\",\n            locale=\"id-ID\")\n        pg = ctx.new_page()\n        pg.goto(url, timeout=60000)\n        time.sleep(sleep)\n        open(page_html_out,\"w\").write(pg.content())\n        b.close()\n\nurl = \"https://www.booking.com/hotel/id/eco-casa-resort.id.html\"\nfetch_with_playwright(\"/tmp/bk_hotel.html\", url)\nh = open(\"/tmp/bk_hotel.html\").read()\nprint(\"hw len:\", len(h))\n# cari link \"ulasan\" / reviewlist\nfor m in re.findall(r'href=\"([^\"]*reviewlist[^\"]*)\"', h)[:5]:\n    print(\"REVIEWLINK:\", urllib.parse.unquote(m)[:160])\n# sensor review count text\nprint(\"ulasan markers:\", h.lower().count(\"ulasan\"))\n# coba reviewlist url\nreview_url = \"https://www.booking.com/reviewlist.id.html?pagename=eco-casa-resort&cc1=id&type=total&rows=100&page=0&filter=all\"\nfetch_with_playwright(\"/tmp/bk_rev.html\", review_url, sleep=9)\nr = open(\"/tmp/bk_rev.html\").read()\nprint(\"rv len:\", len(r))\nprint(\"count container:\", r.count('hprt-review'))\nprint(\"count score:\", len(re.findall(r'\"review_score\"', r)))\nEOF" action.permission=* action.action=allow action.pattern=*
