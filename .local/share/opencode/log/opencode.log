timestamp=2026-09-19T11:23:48.767Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/ta_data/d_season_premiere_jepara.ndjson <<'EOF'\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2026\",\"text\":\"Suasana nyaman, staff hotel dan resto sangat ramah dan informatif.  Harga affordable dan sesuai dengan rasanya.\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jan 2026\",\"text\":\"Viewnya bagus hanya sayang kami datang saat cuaca lagi ekstrim hujan deras trus, anak jadi kecewa ga bisa berenang…. Makanan minumannya enak\\\"….kopi nya sesuai yg dimau\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":4.0,\"date\":\"Mei 2025\",\"text\":\"hotel ini \\\"di ujung\\\" jepara, terletak di kawasan wisata pantai bandengan, lokasinya di pinggir pantai, namun memang pantai di belakang hotel tidak bisa untuk berenang atau main air, jika mau berenang dan main air bisa di pantai bandengan nya,hotel ini kami pakai dalam rangka acara launching IFEX (indonesia International furniture expo) yang akan di laksanakan 5 - 8 maret 2026 di ICE - BSD,kami tidur di sini 1 malam, kesan kami tinggal di sini bisa buat tidur nyenyak, namun memang bantalnya agak kurang lembut dan tidak ada guling atau tanbahan bantal, kasur sepertinya medium, tidak empuk atau tidak keras, namun nyaman untuk di tiduri,untuk kebersihan kolong tempat tidur perlu di pel, kalau lantai kamar bersih, dan bisa buat sholat,untuk kamar mandi pakai rain shower, namun air saat mandi keluar kubikal, akibatnya basah ke dekat wastafel, mungkin perlu di batasi antara kubikal mandi dan wastafel,untuk fasilitas ada kolam renang yang menghadap ke laut, namun karna sehari, tidak sempat mencobanya, untuk sarapan ok ada slice of fruit, roti dan kopi/teh, bubur ayam, bubur manis, soto ayam, dan makanan prasmanan lainnya\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Mar 2025\",\"text\":\"Pertama Kali menginap di hotel ini, Staff ramah, Terutama petugas Front Office mba vina dan mba wulan yg sudah fast respon dan terima kasih sudah di kasih kamar yg view nya bagus 🥰\\nKolam renang nya jg viewnya bagus dan luas, \\nMinus nya cuman handuknya kurang menyerap air saja, yg lain udah oke, semoga bisa balik lagi kesini do next  liburan, Terima kasih d'season\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Okt 2024\",\"text\":\"Hotel resort yg bagus dengan view langsung ke pantai . Cocok buat liburan bersama keluarga. Kamarnya bersih so far so good, untuk kolam renangnya bersih langsung menghadap ke view pantai............recommend buat liburan ke jepara dekat sekali dengan pantai bandengan\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":3.0,\"date\":\"Sep 2024\",\"text\":\"Overall sdh bagus,dari mulai kamar fasilitas,ada meja ping pong juga,viewnya langsung ke laut\\nTempatnya cocok untuk family, gathering corporates,Cocok juga untuk pre wed cuma kadang AC kamar kurang dingin, plus ketika breakfast susu nya basi\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2024\",\"text\":\"Hotelnya nyaman, dapet private pantai, bisa sewa seli juga, ada kolam renangnya yang sangat cukup untuk berenang bareng keluarga, kamarnya nyaman untuk menginap bersama keluarga, view nya ada yang kelihatan pantainya juga, lobbynya wangi\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jul 2024\",\"text\":\"hotel nya bagus bangett, bener bener recommended buat liburan di jepara, bersih dan wangi banget kamar nyaaa, top banget deh dan gak bakal nyesel buat nginep di sini lagi 🥹🤍 dan staff nya juga ramah bangett salah satunya mba vinaa 🤍 pemandangan nya juga top banget\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2024\",\"text\":\"Kamar bersih, nyaman banget, dapat pemandangan sunrise dengan banyak pohon kelapa di sekitarnya\\nPetugas jaga malamnya tetap standby dengan ramah ramah\\nAda persewaan ebike juga, bisa buat boncengan berdua, harganya juga relatif murah\\nTerimakasih d'season\"}\n{\"place\":\"d_season_premiere_jepara\",\"page\":1,\"rating\":5.0,\"date\":\"Jun 2024\",\"text\":\"pengalaman luar biasa, makanan enak, staffnya ramah semua .. pokoknya jadi pengalaman berkesan deh, bakal jadi rekomendasi buat staycation liburan siapa saja yang mau bisa dapet hal indah dekat pantai kolam renang, lapangan bola kecil.\"}\nEOF" action.permission=* action.action=allow action.pattern=*
