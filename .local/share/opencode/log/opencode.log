timestamp=2026-09-19T10:26:41.800Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/maps_scrape.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, re\n\nout = \"/media/rizky/data/projects/skripsi-sentimen/ulasan_maps_unisnu.json\"\nitems = []\nseen = set()\n\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\"])\n    pg = b.new_page()\n    pg.goto(\"https://www.google.com/maps/search/UNISNU+Jepara\", timeout=60000)\n    time.sleep(6)\n    for _ in range(5):\n        pg.mouse.wheel(0, 1500); time.sleep(1.5)\n    # klik tempat pertama\n    try:\n        pg.locator(\"a[href*='/maps/place/']\").first.click(timeout=8000)\n    except Exception:\n        pass\n    time.sleep(5)\n    # buka panel ulasan\n    try:\n        pg.locator(\"button[aria-label*='ul', exact=False]\").first.click(timeout=8000)\n        # klik menu rerun untuk semua ulasan\n        pg.keyboard.press(\"Tab\"); time.sleep(1)\n    except Exception as e:\n        print(\"err open reviews:\", e)\n    time.sleep(4)\n\n    for i in range(40):\n        pg.mouse.wheel(0, 4000); time.sleep(1.2)\n        cards = pg.locator(\"div[role='article']\")\n        n = cards.count()\n        for j in range(n):\n            try:\n                el = cards.nth(j)\n                txt = el.inner_text()\n                if txt and txt not in seen:\n                    seen.add(txt)\n                    items.append(txt)\n            except Exception:\n                pass\n        print(f\"iter {i}: total={len(items)}\")\n\nprint(\"FINAL_TOTAL:\", len(items))\nwith open(out, \"w\") as f:\n    import json; json.dump(list(seen), f, ensure_ascii=False, indent=1)\nb.close() if False else None\nEOF" action.permission=* action.action=allow action.pattern=*
