timestamp=2026-09-19T11:04:02.575Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/parse_ta.py <<'EOF'\nimport re, json\n\nfiles = {\n    \"attraction_jepara\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b95202400016iO07Eoiuy0AVw\",\n    \"attraction_karimun\": \"/home/rizky/.local/share/opencode/tool-output/tool_0b9527e11001AAF2fxTJFD1FaI\",\n    \"hotel_karimun\":      \"/home/rizky/.local/share/opencode/tool-output/tool_0b9528501001W1ncK5fYiom5ow\",\n    \"hotel_jepara\":       \"/home/rizky/.local/share/opencode/tool-output/tool_0b952871b001kh7htsbeSAVZFQ\",\n}\nREGION = {\"attraction_jepara\": \"Jepara\", \"attraction_karimun\": \"Karimunjawa\",\n          \"hotel_karimun\": \"Karimunjawa\", \"hotel_jepara\": \"Jepara\"}\n\ndef slug_name(url):\n    s = url.rsplit(\".html\",1)[0].split(\"-Reviews-\")[-1]\n    for suf in (\"-Jepara_Central_Java_Java\", \"-Karimun_Jawa_Central_Java_Java\"):\n        if s.endswith(suf): s = s[:-len(suf)]\n    return s.replace(\"_\", \" \")\n\ndef is_local(url):\n    return (\"-Jepara_Central_Java_Java.html\" in url or\n            \"-Karimun_Jawa_Central_Java_Java.html\" in url)\n\nplaces = {}\nfor cat, path in files.items():\n    txt = open(path).read()\n    for m in re.finditer(r'/(Hotel|Attraction)_Review-(g\\d+-d\\d+)-([A-Za-z0-9_-]+\\.html)', txt):\n        url = \"/\" + m.group(1) + \"_Review-\" + m.group(2) + \"-\" + m.group(3)\n        if url in places: continue\n        if not is_local(url): continue\n        base = url.rsplit(\".html\",1)[0]\n        # slice between last '](URL)[...' opener and '#REVIEWS)'\n        opener = txt.rfind(\"](\" + base + \").html)[\", 0, txt.find(url + \"#REVIEWS\"))\n        closer = txt.find(base + \".html#REVIEWS)\", txt.find(url + \"#REVIEWS\"))\n        if opener == -1 or closer == -1:\n            continue\n        seg = txt[opener:closer]\n        rr = re.search(r'([\\d,]+) dari 5 lingkaran\\s*\\n\\s*\\((\\d[\\d.,]*)\\)', seg)\n        c = re.search(r'^\\((\\d[\\d.,]*)\\)', seg, re.M)\n        count = int(rr.group(2).replace('.','').replace(',','')) if rr else (int(c.group(1).replace('.','').replace(',','')) if c else 0)\n        rating = float(rr.group(1).replace(',','.')) if rr else None\n        places[url] = {\"category\": m.group(1).lower(), \"region\": REGION[cat] if REGION[cat] else \"?\",\n                       \"name\": slug_name(url), \"url\": url, \"count\": count, \"rating\": rating}\n\n# fix region for attractions that are Karimunjawa-listed under Jepara? keep file region\nitems = sorted(places.values(), key=lambda x: -x[\"count\"])\nprint(f\"total lokal unik: {len(items)}, total ulasan: {sum(p['count'] for p in items)}\")\nfor p in items:\n    print(f\"{p['category']:10} {p['region']:12} {p['count']:>5} {p['rating']}  {p['name']}\")\njson.dump(items, open('/tmp/ta_places.json','w'), ensure_ascii=False, indent=1)\nEOF" action.permission=* action.action=allow action.pattern=*
