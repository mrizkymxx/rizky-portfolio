timestamp=2026-09-19T10:49:45.100Z level=INFO run=c7194927 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport re, html as h\nd = open(\"/tmp/bk_hotel.html\").read()\n# cari marker review umum\nfor pat in [\"guest_list_item\",\"review__title\",\"c-review-block\",\"data-review-score\",\"hp-review\",\"review_scores\",\"bui-review-score\",\"review_score\",\"show_all_reviews\",\"stay_reviews_link\",\"tab-reviews\",\"ratings_table\",\"hp_review\"]:\n    print(f\"{pat:22s} -> {len(re.findall(pat, d))}\")\n# ekstrak teks untuk lihat apakah ada isi ulasan\nt = re.sub(r\"<script.*?</script>\",\"\",d,flags=re.S)\nt = re.sub(r\"<style.*?</style>\",\"\",t,flags=re.S)\ntxt = re.sub(r\"\\s+\",\" \", re.sub(r\"<[^>]+>\",\" \",t))\n# cari frasa khas review\nfor kw in [\"sangat baik\",\"istimewa\",\"stay\",\"Review\",\"review\",\"ulasan tamu\",\"Kamar\",\"staf\",\"lokasi\"]:\n    i = txt.find(kw)\n    if i>=0:\n        print(\"SAMPLE:\", kw, \"|\", txt[max(0,i-40):i+90])\n        break\nEOF" action.permission=* action.action=allow action.pattern=*
