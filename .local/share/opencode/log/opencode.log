timestamp=2026-09-19T10:37:57.965Z level=INFO run=c7194927 message=evaluated permission=bash pattern="cat > /tmp/maps15.py <<'EOF'\nfrom playwright.sync_api import sync_playwright\nimport time, json, re\n\nout = \"/media/rizky/data/projects/skripsi-sentimen/ulasan_maps_unisnu.json\"\nseen = {}\n\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=[\"--no-sandbox\", \"--disable-blink-features=AutomationControlled\"])\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 950},\n        user_agent=\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\")\n    pg = ctx.new_page()\n    pg.goto(\"https://www.google.com/maps/search/UNISNU+Jepara\", timeout=60000)\n    time.sleep(12)\n\n    def click_first(pos, sel):\n        for attempt in range(6):\n            try:\n                pg.locator(sel).first.click(timeout=8000); return True\n            except Exception as e:\n                time.sleep(4)\n        return False\n\n    ok = click_first(0, \"button\").__bool__ if False else True\n    # klik tab ulasan\n    ok = False\n    for _ in range(8):\n        try:\n            pg.locator(\"button\", has_text=re.compile(r\"^\\s*Ulasan\\s*$\")).first.click(timeout=7000)\n            ok = True; print(\"tab ulasan OK\"); break\n        except Exception:\n            time.sleep(5)\n            pg.goto(\"https://www.google.com/maps/search/UNISNU+Jepara\", timeout=60000)\n            time.sleep(8)\n    if not ok:\n        print(\"GAGAL BUKA TAB ULASAN\"); b.close(); raise SystemExit(1)\n    time.sleep(5)\n    # buka modal semua ulasan\n    for _ in range(4):\n        try:\n            pg.locator(\"span\", has_text=\"Ulasan lainnya\").first.click(timeout=7000)\n            print(\"modal semua OK\"); break\n        except Exception:\n            time.sleep(4)\n    time.sleep(7)\n    print(\"LEN body:\", len(pg.inner_text(\"body\")))\n\n    # cari container scroll (modal ulasan Maps punya class m6QErb)\n    container = None\n    for i in range(pg.locator(\"div[class*='m6QErb']\").count()):\n        try:\n            h = pg.locator(\"div[class*='m6QErb']\").nth(i).evaluate(\"el => el.scrollHeight\")\n            if h > 2000: container = pg.locator(\"div[class*='m6QErb']\").nth(i); print(\"container\", i, h); break\n        except Exception: pass\n\n    for i in range(200):\n        try:\n            if container: container.evaluate(\"el => el.scrollBy(0, 8000)\")\n            else: pg.mouse.wheel(0, 5000)\n        except Exception: pass\n        time.sleep(0.5)\n        try:\n            for j in range(pg.locator(\"div[role='article']\").count()):\n                t = pg.locator(\"div[role='article']\").nth(j).inner_text()\n                if t and t not in seen: seen[t] = True\n        except Exception: pass\n        if i % 25 == 0: print(\"i=\", i, \"rev=\", len(seen))\n    print(\"FINAL:\", len(seen))\n    json.dump(list(seen.keys()), open(out, \"w\"), ensure_ascii=False, indent=1)\n    b.close()\nEOF" action.permission=* action.action=allow action.pattern=*
